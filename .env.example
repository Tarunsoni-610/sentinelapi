# Copy to .env - used from Phase 2 onward (scanner). Never commit real keys.
LLM_PROVIDER=gemini            # gemini | openai | none
GEMINI_API_KEY=
OPENAI_API_KEY=
SCANNER_PORT=5000
# Scanner only scans these hosts (comma separated). Anything else is refused.
ALLOWED_TARGETS=localhost,127.0.0.1,sandbox-api
